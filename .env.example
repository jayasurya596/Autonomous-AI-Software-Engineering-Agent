# Copy to .env for local development. Replace placeholders before starting services.
APP_ENV=development
API_HOST=127.0.0.1
API_PORT=8000
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
API_RATE_LIMIT_REQUESTS=120
API_RATE_LIMIT_WINDOW_SECONDS=60
MAX_REQUEST_BODY_BYTES=1048576

POSTGRES_DB=software_agent
POSTGRES_USER=software_agent
POSTGRES_PASSWORD=replace-with-a-local-development-password
POSTGRES_HOST_PORT=5433
DATABASE_URL=postgresql+psycopg://software_agent:replace-with-a-local-development-password@localhost:5433/software_agent
# Generate a Fernet key locally before connecting GitHub: uv run python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
GITHUB_CREDENTIALS_ENCRYPTION_KEY=replace-with-a-generated-fernet-key

OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:1b
OLLAMA_EMBEDDING_MODEL=nomic-embed-text
OLLAMA_TIMEOUT_SECONDS=180
OLLAMA_NUM_PREDICT=3072
AGENT_REPOSITORIES_ROOT=.agent-repositories
SANDBOX_PYTHON_IMAGE=agent-sandbox-python:local
SANDBOX_NODE_IMAGE=agent-sandbox-node:local
SANDBOX_TIMEOUT_SECONDS=120

# Demo project values work with the local Auth Emulator and never contact Firebase Cloud.
FIREBASE_PROJECT_ID=demo-software-agent
FIREBASE_ADMIN_CREDENTIALS_PATH=
FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
FIRESTORE_EMULATOR_HOST=127.0.0.1:8080

# Vite only exposes VITE_* values to the browser. Use values from the Firebase
# web app configuration; never put Admin SDK credentials in VITE_* variables.
VITE_FIREBASE_API_KEY=demo-api-key
VITE_FIREBASE_AUTH_DOMAIN=demo-software-agent.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=demo-software-agent
VITE_FIREBASE_APP_ID=1:123456789:web:local-demo
VITE_FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
