# Copy to .env.cloudflare. Keep this file private and never commit it.
# Cloudflare account credentials are handled through Wrangler login and bindings.

# The Firebase web app configuration is read from .env.production.local.
FIREBASE_PROJECT_ID=agent-swe-20261109-8f03
FIREBASE_ADMIN_CREDENTIALS_FILE=replace-with-path-to-firebase-admin-service-account-json

# Create a free Neon PostgreSQL database and enable the vector extension.
# Use its PostgreSQL connection string with sslmode=require and the +psycopg driver.
DATABASE_URL=postgresql+psycopg://user:password@host.region.neon.tech/database?sslmode=require

# Generate once with: uv run python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
GITHUB_CREDENTIALS_ENCRYPTION_KEY=replace-with-generated-fernet-key
