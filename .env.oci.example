# Copy this file to .env.oci on the OCI VM and fill in the values.
# Never commit .env.oci or the Firebase Admin JSON key.

APP_DOMAIN=replace-with-public-hostname
CORS_ORIGINS=https://replace-with-public-hostname

# Set to the OCI VM's Docker socket group ID (getent group docker | cut -d: -f3).
DOCKER_GID=999
# Use absolute paths, create the sandbox directory, and make it writable by UID 10001.
SANDBOX_SHARED_PATH=/opt/autonomous-agent/agent-staging
FIREBASE_ADMIN_KEY_FILE=/opt/autonomous-agent/secrets/firebase-admin.json

POSTGRES_DB=software_agent
POSTGRES_USER=software_agent
# Generate with: openssl rand -hex 32
POSTGRES_PASSWORD=replace-with-64-hex-characters

FIREBASE_PROJECT_ID=agent-swe-20261109-8f03
VITE_FIREBASE_API_KEY=replace-with-firebase-web-api-key
VITE_FIREBASE_AUTH_DOMAIN=agent-swe-20261109-8f03.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=agent-swe-20261109-8f03
VITE_FIREBASE_APP_ID=replace-with-firebase-web-app-id
VITE_FIREBASE_GOOGLE_AUTH_ENABLED=false

API_RATE_LIMIT_REQUESTS=120
API_RATE_LIMIT_WINDOW_SECONDS=60
MAX_REQUEST_BODY_BYTES=1048576
OLLAMA_MODEL=llama3.2:1b
OLLAMA_EMBEDDING_MODEL=nomic-embed-text
OLLAMA_TIMEOUT_SECONDS=240
OLLAMA_NUM_PREDICT=1536
SANDBOX_TIMEOUT_SECONDS=120
# Generate with the project command in README.md. Keep this key backed up and private.
GITHUB_CREDENTIALS_ENCRYPTION_KEY=replace-with-generated-fernet-key
